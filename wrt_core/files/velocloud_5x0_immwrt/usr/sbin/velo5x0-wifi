#!/bin/sh
# velo5x0-wifi on|off|status|enabled: maintenance WiFi (normally off; the failover hook
# turns it on while running on cellular, a dashboard can call this over SSH).
. /lib/functions.sh

radio=""
phy=""
find_radio() {
	local found

	[ -z "$radio" ] || return 0
	found=$(iwinfo nl80211 phyname "$1" 2>/dev/null)
	[ -n "$found" ] && [ -d "/sys/class/ieee80211/$found" ] || return 0
	radio="$1"
	phy="$found"
}

case "$1" in
	on|off|status|enabled) ;;
	*) echo "usage: velo5x0-wifi on|off|status|enabled"; exit 1 ;;
esac

# A moved card gets a new config section; ignore sections without a PHY.
config_load wireless
config_foreach find_radio wifi-device
if [ -z "$radio" ]; then
	[ "$1" != status ] || echo "wifi unavailable"
	exit 1
fi
config_get_bool disabled "$radio" disabled 0

case "$1" in
	on|off)
		value=0
		[ "$1" != off ] || value=1
		uci set "wireless.$radio.disabled=$value" &&
			uci commit wireless &&
			wifi reload || exit 1
		echo "wifi $1"
		;;
	enabled)
		[ "$disabled" = 0 ]
		;;
	status)
		if [ "$disabled" = 0 ]; then
			ssid=$(iw dev 2>/dev/null | awk -v phy="$phy" '
				/^phy#/ { selected = ($0 == "phy#" substr(phy, 4)) }
				selected && $1 == "ssid" {
					sub(/^[ \t]*ssid[ \t]+/, "")
					print
					exit
				}')
			echo "wifi on${ssid:+ ($ssid)}"
		else
			echo "wifi off"
		fi
		;;
esac
